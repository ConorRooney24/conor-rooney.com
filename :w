/* Hero Section */

.sec-hero {
    display: flex;
    justify-content: space-between;
    font-size: 1em;
}

.sec-hero--main {
    font-size: 1em;
}

.sec-hero--main > .cmp-status-label {
    margin-bottom: 0.8em;
}

.sec-hero--main > h1 {
    font-size: 3.75em;
    margin: 0;
    margin-bottom: -10px;
    letter-spacing: 1px;
}

.sec-hero--main > p {
    font-size: 22px;
}

.sec-hero--main > div {
    display: flex;
    gap: 38px;
    font-size: 1.2em;
}

.sec-hero--main > div > .cmp-button-icon {
    display: none;
}

.sec-hero--side {
    min-width: 260px;
    border-left: 1px solid var(--color-bg-3);
    padding-left: 34px;
    margin-left: 160px;
}

.sec-hero--side > p {
    font-size: 22px;
}

@media (max-width: 1200px) {
    .sec-hero--main > h1 {
        font-size: 3.12em;
        margin-bottom: -10px;
        letter-spacing: 1px;
    }

    .sec-hero--main > p {
        font-size: 20px;
    }

    .sec-hero--side > p {
        font-size: 20px;
    }

    .sec-hero--side {
        padding-left: 30px;
        margin-left: 50px;
    }

    .sec-hero--main > .cmp-status-label {
        font-size: 0.9em;
    }
}

@media (max-width: 1050px) {
    .sec-hero--side {
        display: none;
    }

    .sec-hero--main {
        margin-right: 20vw;
    }
}

@media (max-width: 850px) {
    .sec-hero--main {
        margin-right: 0;
    }
}

@media (max-width: 800px) {
    .sec-hero--main > div > .cmp-button-icon {
        display: inline-flex;
    }

    .sec-hero--main > div {
        padding-top: 18px;
        align-items: center;
        font-size: 1em;
    }

    .sec-hero--main > .cmp-status-label {
        margin-bottom: 0;
    }
}

@media (max-width: 600px) {
    .sec-hero--main > h1 {
        font-size: 40px;
    }

    .sec-hero--main > p {
        margin-top: 16px;
        font-size: 18px;
    }

    .sec-hero--main > div {
        padding-top: 8px;
    }

    .sec-hero--main > div > .cmp-button-icon {
        font-size: 16px;
    }

    .sec-hero--main > .cmp-status-label {
        font-size: 0.75em;
        margin-bottom: 0.4em;
    }
}

@media (max-width: 475px) {
    .sec-hero--main > h1 {
        font-size: 30px;
    }

    .sec-hero--main > p {
        font-size: 16px;
    }
}
